NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=barbershop

# Comma-separated list of allowed browser origins (admin + web)
CORS_ORIGINS=http://localhost:3039,http://localhost:5173

# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# The admin account is created on first boot if it does not exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
