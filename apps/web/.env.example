# Leave empty to call the API on the same origin (/api). Vite proxies it in dev.
VITE_API_URL=
VITE_CURRENCY=INR
VITE_LOCALE=en-IN

# Shop details shown on the landing page
VITE_SHOP_NAME=The Gentlemen's Barber
VITE_SHOP_TAGLINE=Sharp cuts. Hot towels. Good conversation.
VITE_SHOP_PHONE=+91 98765 43210
VITE_SHOP_EMAIL=hello@gentlemensbarber.example
VITE_SHOP_ADDRESS=12 Hill Road, Bandra West, Mumbai 400050
VITE_SHOP_MAPS_URL=https://maps.google.com/?q=Bandra+West+Mumbai
VITE_SHOP_INSTAGRAM=https://instagram.com/
# Opening hours, "Label=Time" separated by |
VITE_SHOP_HOURS=Mon – Fri=10:00 – 21:00|Saturday=09:00 – 21:00|Sunday=10:00 – 18:00

# Dev server only: where Vite forwards /api requests
API_PROXY_TARGET=http://localhost:4000
