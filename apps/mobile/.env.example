# Where the app finds the API. Leave empty in development: the app then uses
# the same machine that runs `expo start` (your laptop's LAN IP) on port 4000.
#   Android emulator talking to your laptop: http://10.0.2.2:4000/api
#   Production:                               https://www.yourshop.com/api
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=4000

EXPO_PUBLIC_CURRENCY=INR
EXPO_PUBLIC_LOCALE=en-IN

EXPO_PUBLIC_SHOP_NAME=The Gentlemen's Barber
EXPO_PUBLIC_SHOP_TAGLINE=Sharp cuts. Hot towels. Good conversation.
EXPO_PUBLIC_SHOP_PHONE=+91 98765 43210
EXPO_PUBLIC_SHOP_EMAIL=hello@gentlemensbarber.example
EXPO_PUBLIC_SHOP_ADDRESS=12 Hill Road, Bandra West, Mumbai 400050
EXPO_PUBLIC_SHOP_MAPS_URL=https://maps.google.com/?q=Bandra+West+Mumbai
EXPO_PUBLIC_SHOP_INSTAGRAM=
EXPO_PUBLIC_SHOP_HOURS=Mon – Fri=10:00 – 21:00|Saturday=09:00 – 21:00|Sunday=10:00 – 18:00

# Store identity (used by app.config.ts)
APP_IDENTIFIER=com.example.barbershop
