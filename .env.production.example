# Copy to .env.production and fill in. Never commit the real file.

# --- Required secrets ---
# openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Public URLs (used for CORS and the admin's "View website" link) ---
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_ADMIN_URL=http://localhost:8081
WEB_PORT=8080
ADMIN_PORT=8081

# true when served over HTTPS (recommended). Set false only to try the stack on plain http://localhost
COOKIE_SECURE=false

# --- Shop details baked into the landing page at build time ---
CURRENCY=INR
LOCALE=en-IN
SHOP_NAME=The Gentlemen's Barber
SHOP_TAGLINE=Sharp cuts. Hot towels. Good conversation.
SHOP_PHONE=+91 98765 43210
SHOP_EMAIL=hello@gentlemensbarber.example
SHOP_ADDRESS=12 Hill Road, Bandra West, Mumbai 400050
SHOP_MAPS_URL=https://maps.google.com/?q=Bandra+West+Mumbai
SHOP_INSTAGRAM=
SHOP_HOURS=Mon – Fri=10:00 – 21:00|Saturday=09:00 – 21:00|Sunday=10:00 – 18:00
